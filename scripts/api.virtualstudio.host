server {
    listen 80;
    server_name api.virtualstudio.host www.api.virtualstudio.host;

    location / {
        include uwsgi_params;
        uwsgi_pass unix:/var/www/virtualstudio/backend/virtualstudio.sock;
    }

    access_log /var/www/virtualstudio/logs/nginx/access.log;
    error_log /var/www/virtualstudio/logs/nginx/error.log;
}